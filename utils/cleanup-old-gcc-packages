#!/bin/bash

# Script to clean up O2PDPSuite packages that depend on older GCC versions
# For ubuntu2204, ubuntu2404, and macOS architectures

set -e
set -o pipefail

# Error handling
trap_error() {
    local exit_code=$?
    local line_number=$1
    log "ERROR: Script failed at line $line_number with exit code $exit_code"
    log "Command: ${BASH_COMMAND}"
    log "Stack trace:"
    local frame=0
    while caller $frame; do
        ((frame++))
    done
    exit $exit_code
}

trap 'trap_error ${LINENO}' ERR

# Configuration
BUCKET="s3://alibuild-repo"
EXCLUDED_GCC_VERSION="14.2"
DRY_RUN=true
VERBOSE=false
PARALLEL_JOBS=50

# Architectures to process
ARCHITECTURES=(
    # "ubuntu2204_x86-64"
    "ubuntu2404_x86-64"
    # "osx_arm64"
)

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Clean up O2PDPSuite packages that depend on older GCC versions.

Options:
    -h, --help              Show this help message
    -y, --do-it             Actually perform deletions (default: dry-run)
    -v, --verbose           Show verbose output
    -g, --gcc-version VER   Exclude packages with GCC version VER (default: $EXCLUDED_GCC_VERSION)
    -a, --arch ARCH         Process only specified architecture (can be repeated)
                            Available: ubuntu2204_x86-64, ubuntu2404_x86-64, osx_arm64
    -j, --jobs NUM          Number of parallel jobs for package resolution (default: $PARALLEL_JOBS)

Examples:
    # Dry-run for all architectures
    $(basename "$0")

    # Actually delete packages for ubuntu2404 only
    $(basename "$0") -y -a ubuntu2404_x86-64

    # Dry-run excluding GCC 13.2
    $(basename "$0") -g 13.2

EOF
}

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" >&2
}

log_verbose() {
    if [[ "$VERBOSE" == "true" ]]; then
        log "$@"
    fi
}

# Function to show elapsed time
show_elapsed() {
    local start_time=$1
    local end_time=$(date +%s)
    local elapsed=$((end_time - start_time))
    local minutes=$((elapsed / 60))
    local seconds=$((elapsed % 60))
    echo "${minutes}m${seconds}s"
}

# Calculate percentage (with fallback if bc is not available)
calc_percent() {
    local current=$1
    local total=$2
    if command -v bc &>/dev/null; then
        echo "scale=1; $current * 100 / $total" | bc -l 2>/dev/null || echo "0"
    else
        # Fallback: use shell arithmetic (will be integer percentage)
        echo $(( current * 100 / total ))
    fi
}
export -f calc_percent

# Parse command-line arguments
CUSTOM_ARCHS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        -y|--do-it)
            DRY_RUN=false
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -g|--gcc-version)
            EXCLUDED_GCC_VERSION="$2"
            shift 2
            ;;
        -a|--arch)
            CUSTOM_ARCHS+=("$2")
            shift 2
            ;;
        -j|--jobs)
            PARALLEL_JOBS="$2"
            shift 2
            ;;
        *)
            echo "Error: Unknown option $1" >&2
            usage
            exit 1
            ;;
    esac
done

# Use custom architectures if specified
if [[ ${#CUSTOM_ARCHS[@]} -gt 0 ]]; then
    ARCHITECTURES=("${CUSTOM_ARCHS[@]}")
fi

if [[ "$DRY_RUN" == "true" ]]; then
    log "DRY-RUN MODE: No packages will be deleted"
else
    log "WARNING: Deletions will be performed!"
fi

log "Excluding GCC version: $EXCLUDED_GCC_VERSION"
log "Processing architectures: ${ARCHITECTURES[*]}"

# Temporary directory for storing intermediate results
TEMP_DIR=$(mktemp -d)
trap 'rm -rf "$TEMP_DIR"' EXIT

# Enhanced error handling for cleanup
cleanup_on_exit() {
    local exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        log "Script terminated with errors. Temporary files preserved at: $TEMP_DIR"
        log "To clean up manually: rm -rf $TEMP_DIR"
        # Don't remove temp dir on error for debugging
        trap - EXIT
    else
        rm -rf "$TEMP_DIR"
    fi
    exit $exit_code
}
trap cleanup_on_exit EXIT

for arch in "${ARCHITECTURES[@]}"; do
    ARCH_START_TIME=$(date +%s)
    log "Processing architecture: $arch"
    
    # Step 1: Find all O2PDPSuite build directories with old GCC
    log "Step 1: Finding O2PDPSuite build directories with old GCC..."
    STEP1_START=$(date +%s)
    
    # List all files recursively and grep for GCC-Toolchain packages with old versions
    ALL_FILES_FILE="$TEMP_DIR/${arch}_all_files.txt"
    log_verbose "Running: s3cmd ls -r $BUCKET/TARS/${arch}/dist/O2PDPSuite/"
    if ! s3cmd ls -r "$BUCKET/TARS/${arch}/dist/O2PDPSuite/" > "$ALL_FILES_FILE" 2>"$TEMP_DIR/${arch}_step1_error.log"; then
        log "ERROR: Failed to list O2PDPSuite directory for $arch"
        cat "$TEMP_DIR/${arch}_step1_error.log" >&2
        continue
    fi
    
    # Find GCC-Toolchain packages that DON'T match the excluded version
    TAGS_WITH_OLD_GCC_FILE="$TEMP_DIR/${arch}_tags_old_gcc.txt"
    log_verbose "Searching for GCC-Toolchain packages not matching version ${EXCLUDED_GCC_VERSION}"
    
    if ! grep "GCC-Toolchain.*\.tar\.gz$" "$ALL_FILES_FILE" > "$TEMP_DIR/${arch}_gcc_packages.txt"; then
        log "No GCC-Toolchain packages found for $arch, skipping..."
        continue
    fi
    
    log_verbose "Found $(wc -l < "$TEMP_DIR/${arch}_gcc_packages.txt") GCC-Toolchain package(s)"
    
    grep -v "GCC-Toolchain-v${EXCLUDED_GCC_VERSION}" "$TEMP_DIR/${arch}_gcc_packages.txt" | \
        awk '{print $4}' | \
        sed 's|/[^/]*\.tar\.gz$|/|' | \
        sort -u > "$TAGS_WITH_OLD_GCC_FILE" || true
    
    log "Step 1 completed in $(show_elapsed $STEP1_START)"
    
    if [[ ! -s "$TAGS_WITH_OLD_GCC_FILE" ]]; then
        log "No build directories with old GCC found for $arch (all using GCC ${EXCLUDED_GCC_VERSION}), skipping..."
        continue
    fi
    
    OLD_GCC_TAG_COUNT=$(wc -l < "$TAGS_WITH_OLD_GCC_FILE")
    log "Found $OLD_GCC_TAG_COUNT build directory(ies) with old GCC dependencies for $arch"
    
    # Step 2: For each build directory, collect all package symlinks
    log "Step 2: Collecting package symlinks from $OLD_GCC_TAG_COUNT build directories..."
    STEP2_START=$(date +%s)
    
    STORE_PATHS_FILE="$TEMP_DIR/${arch}_store_paths.txt"
    > "$STORE_PATHS_FILE"
    
    # Collect all package symlinks from all build directories
    ALL_PACKAGES_FILE="$TEMP_DIR/${arch}_all_packages.txt"
    > "$ALL_PACKAGES_FILE"
    
    tag_num=0
    while IFS= read -r tag_dir; do
        tag_num=$((tag_num + 1))
        printf "\r  Progress: %d/%d build directories listed..." "$tag_num" "$OLD_GCC_TAG_COUNT" >&2
        log_verbose "Listing packages in: $tag_dir"
        # List all .tar.gz files in this build directory (these are symlink text files)
        s3cmd ls "$tag_dir" 2>/dev/null | \
            awk '$4 ~ /\.tar\.gz$/ {print $4}' >> "$ALL_PACKAGES_FILE" || true
    done < "$TAGS_WITH_OLD_GCC_FILE"
    printf "\n" >&2
    
    log "Step 2 completed in $(show_elapsed $STEP2_START)"
    
    if [[ ! -s "$ALL_PACKAGES_FILE" ]]; then
        log "No packages found for $arch, skipping..."
        continue
    fi
    
    PACKAGE_COUNT=$(wc -l < "$ALL_PACKAGES_FILE")
    log "Step 3: Resolving $PACKAGE_COUNT package symlinks to store paths in parallel (max $PARALLEL_JOBS jobs)..."
    STEP3_START=$(date +%s)
    
    # Function to process a single package symlink
    process_package() {
        local package_url="$1"
        local temp_output="$2"
        local progress_file="$3"
        local error_log="$4"
        
        # Fetch the symlink content (these are text files containing the real store path)
        local store_path
        if ! store_path=$(s3cmd get "$package_url" -q - 2>"${error_log}.${package_url//\//_}"); then
            echo "ERROR: Failed to fetch $package_url" >> "$error_log"
            echo "1" >> "$progress_file"
            return 1
        fi
        
        # Clean up the output (remove newlines and trailing %)
        store_path=$(echo "$store_path" | tr -d '\n' | sed 's/%$//')
        
        if [[ -n "$store_path" && "$store_path" == TARS/* ]]; then
            # Prepend bucket to get full S3 URL
            local full_store_path="${BUCKET}/${store_path}"
            echo "$full_store_path" >> "$temp_output"
        else
            echo "WARNING: Invalid store path for $package_url: '$store_path'" >> "$error_log"
        fi
        
        # Update progress counter
        echo "1" >> "$progress_file"
    }
    export -f process_package
    export BUCKET
    
    # Create progress tracking file for packages
    PACKAGE_PROGRESS_FILE="$TEMP_DIR/${arch}_package_progress.txt"
    > "$PACKAGE_PROGRESS_FILE"
    
    # Create error log file
    ERROR_LOG_FILE="$TEMP_DIR/${arch}_errors.log"
    > "$ERROR_LOG_FILE"
    
    # Start progress monitor in background
    (
        while true; do
            if [[ -f "$PACKAGE_PROGRESS_FILE" ]]; then
                resolved=$(wc -l < "$PACKAGE_PROGRESS_FILE" 2>/dev/null || echo 0)
                if [[ $resolved -ge $PACKAGE_COUNT ]]; then
                    break
                fi
                # Use \r to overwrite the same line
                pct=$(calc_percent "$resolved" "$PACKAGE_COUNT")
                printf "\r  Progress: %d/%d packages resolved (%s%%)..." "$resolved" "$PACKAGE_COUNT" "$pct" >&2
            fi
            sleep 1
        done
        # Final update
        printf "\r  Progress: %d/%d packages resolved (100%%)    \n" "$PACKAGE_COUNT" "$PACKAGE_COUNT" >&2
    ) &
    PACKAGE_PROGRESS_PID=$!
    
    # Process all packages in parallel using xargs
    cat "$ALL_PACKAGES_FILE" | xargs -P "$PARALLEL_JOBS" -I {} bash -c 'process_package "$@"' _ {} "$STORE_PATHS_FILE" "$PACKAGE_PROGRESS_FILE" "$ERROR_LOG_FILE"
    
    # Wait for progress monitor to finish
    wait $PACKAGE_PROGRESS_PID 2>/dev/null || true
    
    # Check for errors
    if [[ -s "$ERROR_LOG_FILE" ]]; then
        ERROR_COUNT=$(wc -l < "$ERROR_LOG_FILE")
        log "WARNING: Encountered $ERROR_COUNT error(s) during package resolution"
        log_verbose "Error details:"
        if [[ "$VERBOSE" == "true" ]]; then
            cat "$ERROR_LOG_FILE" >&2
        else
            log "Run with -v/--verbose to see error details, or check: $ERROR_LOG_FILE"
        fi
    fi
    
    log "Step 3 completed in $(show_elapsed $STEP3_START)"
    
    if [[ ! -s "$STORE_PATHS_FILE" ]]; then
        log "No store paths found for $arch, skipping..."
        continue
    fi
    
    # Sort and deduplicate store paths
    sort -u "$STORE_PATHS_FILE" -o "$STORE_PATHS_FILE"
    STORE_COUNT=$(wc -l < "$STORE_PATHS_FILE")
    log "Found $STORE_COUNT unique store path(s) to delete for $arch"
    
    # Step 4: Delete the store paths (but not the symlinks)
    log "Step 4: Deleting store paths..."
    
    if [[ "$DRY_RUN" == "true" ]]; then
        log "DRY-RUN: Would delete the following store paths for $arch:"
        cat "$STORE_PATHS_FILE"
    else
        DELETED=0
        FAILED=0
        DELETION_ERROR_LOG="$TEMP_DIR/${arch}_deletion_errors.log"
        > "$DELETION_ERROR_LOG"
        
        while IFS= read -r store_path; do
            log_verbose "Deleting: $store_path"
            if s3cmd rm "$store_path" 2>>"$DELETION_ERROR_LOG"; then
                ((DELETED++))
                log_verbose "Deleted: $store_path"
            else
                ((FAILED++))
                log "Failed to delete: $store_path"
            fi
        done < "$STORE_PATHS_FILE"
        
        log "Deleted $DELETED store path(s) for $arch"
        if [[ $FAILED -gt 0 ]]; then
            log "WARNING: Failed to delete $FAILED store path(s) for $arch"
            log "Deletion errors logged to: $DELETION_ERROR_LOG"
            if [[ "$VERBOSE" == "true" ]]; then
                cat "$DELETION_ERROR_LOG" >&2
            fi
        fi
    fi
    
    log "Finished processing architecture: $arch (total time: $(show_elapsed $ARCH_START_TIME))"
    echo ""
done

log "Cleanup complete!"

if [[ "$DRY_RUN" == "true" ]]; then
    log "This was a DRY-RUN. Use -y/--do-it to actually delete packages."
fi
